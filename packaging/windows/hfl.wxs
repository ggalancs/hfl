<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Copyright (c) 2026 Gabriel Galán Pelayo

  WiX (Windows Installer XML) recipe for HFL (Phase 17 — V2 row 30).

  Produces an MSI (signed when windows-msi.yml has a certificate) that
  installs HFL into Program Files for all users and puts ``hfl.exe`` on
  the system PATH. It registers no service: ``hfl serve`` is started by
  the user. Checked without installing by the local audit (F7).

  The ``ProductVersion`` and ``ProductCode`` placeholders are
  patched by ``.github/workflows/windows-msi.yml`` on each v* tag.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="HFL"
    Language="1033"
    Version="@HFL_VERSION@"
    Manufacturer="Gabriel Galán Pelayo"
    UpgradeCode="F9FDE6C0-1D4C-4B7B-8C18-5AEA57F3A5C1">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="HFL — Run HuggingFace models locally, Ollama-compatible"
      Comments="Licensed under Apache-2.0" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of HFL is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ggalancs/hfl" />
    <Property Id="ARPCONTACT" Value="ggalancs@gmail.com" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HFL" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <!-- The Id ends in .ico: the Start menu and Programs and Features read
         the icon by that extension. -->
    <Icon Id="HflIcon.ico" SourceFile="packaging\windows\hfl.ico" />
    <Property Id="ARPPRODUCTICON" Value="HflIcon.ico" />

    <ComponentGroup Id="HflFiles" Directory="INSTALLFOLDER">
      <Component Id="HflExecutable" Guid="*" Win64="yes">
        <File
          Id="HflExe"
          Source="dist\hfl.exe"
          KeyPath="yes" />
        <!-- Put the install dir on PATH so ``hfl`` works from any shell. -->
        <Environment
          Id="PathEnv"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="HflShortcuts" Directory="ProgramMenuFolder">
      <!-- "HFL" in the Start menu: the server under its tray icon, and the
           chat page in the browser. The console it starts in is hidden by
           HFL itself once the tray is up. A shortcut to the file, not an
           advertised one: ICE50 wants an advertised shortcut's icon named
           like its target, an .exe (the 70 MB executable twice in the MSI),
           and a click on one runs Windows Installer's repair check first.
           Outside the file's component, it needs a key path under HKCU
           (ICE38, ICE43). -->
      <Component Id="HflStartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut
          Id="HflStartMenu"
          Name="HFL"
          Description="Run Hugging Face models on this computer"
          Target="[#HflExe]"
          WorkingDirectory="INSTALLFOLDER"
          Arguments="serve --tray --open"
          Icon="HflIcon.ico"
          Show="minimized" />
        <RegistryValue
          Root="HKCU"
          Key="Software\HFL"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Core" Title="HFL Core" Level="1">
      <ComponentGroupRef Id="HflFiles" />
      <ComponentGroupRef Id="HflShortcuts" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\LICENSE.rtf" />
  </Product>
</Wix>
